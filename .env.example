# Site selection (1–40)
SITE_NUMBER=1
NEXT_PUBLIC_SITE_NUMBER=1

# Same-origin PHP mailer (production / NameHero). Leave unset to use /api/submit.php
# NEXT_PUBLIC_SUBMIT_API_URL=https://local-orbit.com/api/submit.php

# Optional SMTP. Leave SMTP_HOST empty to use cPanel PHP mail()
# (create mailbox info@local-orbit.com in cPanel first).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@local-orbit.com
MAIL_FROM_NAME=Local Orbit
MAIL_TO=info@local-orbit.com
MAIL_TO_NAME=Local Orbit
